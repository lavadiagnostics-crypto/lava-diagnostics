########################################
# LAVA Diagnostics — environment
# Copy to `.env` and fill in. Never commit `.env`.
########################################

# ── Database ───────────────────────────
# Pooled connection (PgBouncer) used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection used by `prisma migrate` — port 5432, no pooler in the host.
# The Neon/Vercel integration creates this one for you automatically.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/postgres"

# ── Auth.js / NextAuth ─────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Canonical public origin. Used in emails and QR code payloads.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Certificate integrity ──────────────
# Independent 32-byte secret used to HMAC certificate hashes and to sign the
# short-lived grants that authorise a single certificate's PDF stream.
# Rotating this invalidates previously issued certificate hashes — do not rotate
# without re-hashing existing certificates.
CERTIFICATE_HASH_SECRET="replace-me-with-a-separate-32-byte-random-string"

# ── Object storage ─────────────────────
# "supabase" (production) or "local" (development, writes to ./.storage)
STORAGE_DRIVER="local"
# Required when STORAGE_DRIVER=supabase. The bucket MUST be created as PRIVATE.
SUPABASE_URL=""
# Service-role key. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lava-certificates"

# ── Transactional email ────────────────
# "resend" (production) or "console" (development, logs to stdout)
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="LAVA Diagnostics <no-reply@lavadiagnostics.com>"
EMAIL_REPLY_TO="support@lavadiagnostics.com"
# Internal address that receives contact-form and new-order notifications.
EMAIL_INTERNAL_INBOX="support@lavadiagnostics.com"

# ── Rate limiting (optional) ───────────
# Without these, the verification endpoint falls back to a per-instance
# in-memory limiter. Strongly recommended on multi-instance deployments.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Seed credentials (development only) ─
SEED_ADMIN_EMAIL="admin@lavadiagnostics.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_CUSTOMER_EMAIL="research@nordpeak.example"
SEED_CUSTOMER_PASSWORD="ChangeMe!2026"
